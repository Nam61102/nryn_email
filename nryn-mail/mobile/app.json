{
  "expo": {
    "name": "NRYN Mail",
    "slug": "nryn-mail",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "light",

    "_comment_scheme": "This is how Google reopens the app after consent. It MUST match APP_SCHEME in backend/.env.",
    "scheme": "nrynmail",

    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "in.kindersports.nrynmail"
    },
    "android": {
      "package": "in.kindersports.nrynmail",
      "adaptiveIcon": {
        "backgroundColor": "#4F46E5",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#4F46E5",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    }
  }
}
