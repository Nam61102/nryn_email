# --- server ---
PORT=4100
NODE_ENV=development
# Deep-link scheme for the mobile app. MUST match "scheme" in mobile/app.json.
APP_SCHEME=nrynmail
# Only needed if you also open the API from a browser. Leave blank for mobile-only.
FRONTEND_URL=

# --- database (local MongoDB) ---
MONGO_URI=mongodb://127.0.0.1:27017/nryn_email

# --- google oauth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4100/api/auth/google/callback

# --- security ---
JWT_SECRET=                 # openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=       # openssl rand -hex 32   (AES-256-GCM, must be 64 hex chars)
SESSION_COOKIE_NAME=nryn_mail_sid

# --- AI (fallback chain: openrouter -> groq -> openai) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-haiku
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- sync & cost guard rails ---
SYNC_CRON=*/3 * * * *
BOOTSTRAP_DAYS=30
BOOTSTRAP_MAX_EMAILS=300
TRIAGE_BODY_CHAR_LIMIT=1500
TRIAGE_BATCH_SIZE=10
